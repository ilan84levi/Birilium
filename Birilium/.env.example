# Birilium Blockchain Node Configuration v2.0
# Copy to .env and customize for your deployment

# ============================================
# SERVER CONFIGURATION
# ============================================
HTTP_PORT=3001
P2P_PORT=6001
NODE_ENV=development

# ============================================
# SECURITY
# ============================================
# API Key (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Leave empty to disable (NOT RECOMMENDED FOR PRODUCTION)
# Default key for development (CHANGE IN PRODUCTION!)
API_KEY=dev_8f3c9d2e1a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0

# Admin credentials for dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB (analytics/explorer only)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=birilium

# LevelDB Path (consensus-critical, Phase 2)
LEVELDB_PATH=./data/chainstate

# ============================================
# BLOCKCHAIN PARAMETERS (v2.0)
# ============================================
MAX_MEMPOOL_SIZE=10000
TX_EXPIRATION_TIME=3600000
MAX_BLOCK_SIZE=1000
MAX_BLOCK_SIZE_BYTES=1048576
INITIAL_DIFFICULTY=4
TARGET_BLOCK_TIME=30000
DIFFICULTY_ADJUSTMENT_INTERVAL=10

# TESTNET FEATURE: LWMA + MTP (Phase 2.2)
# WARNING: Enabling this changes consensus rules
# Only enable on TESTNET - NOT compatible with mainnet
ENABLE_LWMA=false
LWMA_ADJUST_WINDOW=60

# ============================================
# P2P NETWORK (Phase 2.3 - Enhanced Security)
# ============================================
# Comma-separated peer list
# Example: ws://node1.example.com:6001,ws://node2.example.com:6001
# For TLS: wss://node1.example.com:6001
PEERS=

MAX_PEERS=32
P2P_RATE_LIMIT=100
P2P_BAN_SCORE=100

# P2P TLS/WSS Encryption (Phase 2.3)
# Enable for production - encrypts all P2P traffic
ENABLE_P2P_TLS=false
TLS_CERT_PATH=./certs/node-cert.pem
TLS_KEY_PATH=./certs/node-key.pem

# Node Identity (optional - auto-generated if not set)
# Generate: node -e "console.log(require('elliptic').ec('secp256k1').genKeyPair().getPrivate('hex'))"
NODE_PRIVATE_KEY=

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/node.log

# ============================================
# RATE LIMITING (API)
# ============================================
RATE_LIMIT_MAX=100
MINING_RATE_LIMIT_MAX=10

# ============================================
# CORS
# ============================================
# Use * for dev, specific domains for prod
CORS_ORIGINS=http://localhost:*

# ============================================
# MONITORING
# ============================================
METRICS_ENABLED=true
METRICS_PATH=/metrics
