# Birilium Blockchain - Production Environment Configuration
# ============================================================
# Copy this file to .env on your production server
# Update all values marked with [CHANGE]

# ============================================
# SERVER CONFIGURATION
# ============================================
HTTP_PORT=3001
P2P_PORT=6001
NODE_ENV=production

# ============================================
# SECURITY
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=[CHANGE] your_strong_random_key_here

# Admin credentials (generate strong passwords)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERNAME=[CHANGE] prod_admin_user
ADMIN_PASSWORD=[CHANGE] strong_admin_password_min_16_chars

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB for analytics (optional, recommended for production)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=birilium_production

# LevelDB for consensus-critical storage (Phase 2)
LEVELDB_PATH=/var/lib/birilium/chainstate

# ============================================
# BLOCKCHAIN PARAMETERS
# ============================================
# Main network parameters (locked after genesis)
MAX_MEMPOOL_SIZE=10000
TX_EXPIRATION_TIME=3600000
MAX_BLOCK_SIZE=1000
MAX_BLOCK_SIZE_BYTES=1048576
INITIAL_DIFFICULTY=4
TARGET_BLOCK_TIME=30000
DIFFICULTY_ADJUSTMENT_INTERVAL=10

# Feature flags
ENABLE_LWMA=false

# ============================================
# P2P NETWORK - SEED NODES (CRITICAL)
# ============================================
# Production seed nodes (must be stable, geographically distributed)
# Format: wss://hostname:port (TLS required for production)
PEERS=wss://seed1.birilium.net:6001,wss://seed2.birilium.net:6001,wss://seed3.birilium.net:6001

MAX_PEERS=32
P2P_RATE_LIMIT=100
P2P_BAN_SCORE=100

# ============================================
# P2P TLS/MTLS CONFIGURATION (PRODUCTION REQUIRED)
# ============================================
# Enable encryption for all P2P traffic
ENABLE_P2P_TLS=true

# Certificate paths (use absolute paths)
TLS_CERT_PATH=/etc/birilium/tls/node-cert.pem
TLS_KEY_PATH=/etc/birilium/tls/node-key.pem

# CA certificate for peer verification (mutual TLS)
P2P_TLS_CA_CERT=/etc/birilium/tls/ca-cert.pem

# Require peer certificates to be signed by your CA
# Set to true for mainnet (prevents fake nodes)
# Set to false for testnet (allows self-signed)
P2P_TLS_REQUIRE_CLIENT_CERT=true

# Node Identity (auto-generated if not set, but should be deterministic for production)
# Generate: node -e "console.log(require('elliptic').ec('secp256k1').genKeyPair().getPrivate('hex'))"
NODE_PRIVATE_KEY=[OPTIONAL] your_node_private_key_for_deterministic_identity

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FILE=/var/log/birilium/node.log

# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ============================================
# RATE LIMITING (API)
# ============================================
# HTTP API rate limits (requests per 15 minutes per IP)
RATE_LIMIT_MAX=100

# Mining endpoint rate limit
MINING_RATE_LIMIT_MAX=10

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# For production, specify exact allowed origins
# Example: https://wallet.birilium.net,https://app.birilium.net
CORS_ORIGINS=https://wallet.birilium.net

# ============================================
# PAYPAL CONFIGURATION (OPTIONAL - for subscriptions)
# ============================================
# Mode: 'sandbox' for testing, 'live' for production
PAYPAL_MODE=live

# Get from: https://developer.paypal.com/dashboard/
# LIVE CREDENTIALS (DO NOT COMMIT)
PAYPAL_CLIENT_ID=[CHANGE] your_live_client_id
PAYPAL_CLIENT_SECRET=[CHANGE] your_live_secret

# ============================================
# PRODUCTION BEST PRACTICES
# ============================================
# These are enforced by the system:
# - TLS/mTLS is ENABLED
# - Client certificate verification is REQUIRED
# - Certificates must be valid (not self-signed for mainnet)
# - All passwords and keys are 32+ characters
# - Logs are stored in /var/log/birilium/
# - Database runs separately (not embedded)

# ============================================
# CERTIFICATE SETUP INSTRUCTIONS
# ============================================
# Before running in production:
#
# 1. Generate CA (once):
#    node generate-certs.js ca
#
# 2. Generate node certificate:
#    node generate-certs.js signed node1 seed1.birilium.net 203.0.113.20
#
# 3. Copy certificates to secure location:
#    mkdir -p /etc/birilium/tls
#    cp certs/ca-cert.pem /etc/birilium/tls/
#    cp certs/node1-cert.pem /etc/birilium/tls/node-cert.pem
#    cp certs/node1-key.pem /etc/birilium/tls/node-key.pem
#    chmod 700 /etc/birilium/tls
#    chmod 600 /etc/birilium/tls/node-key.pem
#
# 4. Distribute CA certificate to all peers
#
# 5. Set this .env file
#
# 6. Start node:
#    npm start
