# Birilium Blockchain Node Configuration v2.0
# Copy this file to .env and customize for your deployment

# ============================================
# SERVER CONFIGURATION
# ============================================
HTTP_PORT=3001
P2P_PORT=6001
NODE_ENV=development

# ============================================
# SECURITY
# ============================================
# API Key (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Leave empty to disable (NOT RECOMMENDED FOR PRODUCTION)
API_KEY=your_generated_api_key_here

# Admin credentials for dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB (analytics/explorer only - OPTIONAL)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=birilium
LEVELDB_PATH=./data/chainstate

# ============================================
# BLOCKCHAIN PARAMETERS (v2.0)
# ============================================
MAX_MEMPOOL_SIZE=10000
TX_EXPIRATION_TIME=3600000
MAX_BLOCK_SIZE=1000
MAX_BLOCK_SIZE_BYTES=1048576
INITIAL_DIFFICULTY=4
TARGET_BLOCK_TIME=30000
DIFFICULTY_ADJUSTMENT_INTERVAL=10

# TESTNET FEATURE
ENABLE_LWMA=false
LWMA_ADJUST_WINDOW=60

# ============================================
# P2P NETWORK
# ============================================
PEERS=ws://159.65.96.82:6001
MAX_PEERS=32
P2P_RATE_LIMIT=100
P2P_BAN_SCORE=100

# P2P TLS/WSS Encryption
ENABLE_P2P_TLS=false
TLS_CERT_PATH=./certs/node-cert.pem
TLS_KEY_PATH=./certs/node-key.pem
P2P_TLS_CA_CERT=./certs/ca-cert.pem
P2P_TLS_REQUIRE_CLIENT_CERT=false

# Node Identity (generate: node -e "const EC = require('elliptic').ec; const ec = new EC('secp256k1'); console.log(ec.genKeyPair().getPrivate('hex'))")
NODE_PRIVATE_KEY=your_generated_node_private_key_here

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/node.log

# ============================================
# RATE LIMITING (API)
# ============================================
RATE_LIMIT_MAX=100
MINING_RATE_LIMIT_MAX=10

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:*

# ============================================
# MONITORING
# ============================================
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ============================================
# PAYPAL CONFIGURATION
# ============================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_live_client_id_here
PAYPAL_CLIENT_SECRET=your_live_client_secret_here
PAYPAL_PLAN_ID=your_live_plan_id_here

# ============================================
# CONTACT FORM EMAIL
# ============================================
CONTACT_EMAIL=your_email@gmail.com
CONTACT_EMAIL_PASSWORD=your_gmail_app_password_here
