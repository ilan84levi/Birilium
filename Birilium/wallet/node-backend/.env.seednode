# Birilium Seed Node Configuration
# This configuration is for the PUBLIC SEED NODES that other wallets connect to
# Deploy this on a VPS/cloud server with a public IP address

# ============================================
# SERVER CONFIGURATION
# ============================================
HTTP_PORT=3001
P2P_PORT=6001
NODE_ENV=production

# ============================================
# SECURITY
# ============================================
# API Key - REQUIRED for public nodes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=REPLACE_WITH_SECURE_API_KEY

# Admin credentials - CHANGE THESE!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Node identity (for P2P network)
# Generate with: node -e "const EC = require('elliptic').ec; const ec = new EC('secp256k1'); console.log(ec.genKeyPair().getPrivate('hex'))"
NODE_PRIVATE_KEY=REPLACE_WITH_NODE_PRIVATE_KEY

# ============================================
# P2P NETWORK CONFIGURATION
# ============================================
# Maximum number of peer connections
MAX_PEERS=100

# Enable TLS for P2P (HIGHLY RECOMMENDED for production)
ENABLE_P2P_TLS=false
P2P_TLS_REQUIRE_CLIENT_CERT=false

# Initial peers to connect to (comma-separated)
# Leave empty for seed nodes, as they wait for incoming connections
PEERS=

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB for persistent blockchain storage (REQUIRED for seed nodes)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=birilium

# ============================================
# PAYPAL CONFIGURATION
# ============================================
# Production PayPal credentials
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR_LIVE_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_LIVE_PAYPAL_CLIENT_SECRET
PAYPAL_PLAN_ID=YOUR_LIVE_PLAN_ID

# ============================================
# BLOCKCHAIN SETTINGS
# ============================================
# These should match across all nodes in the network
# DO NOT CHANGE unless you know what you're doing!
ENABLE_LWMA=true
