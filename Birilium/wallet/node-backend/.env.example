# Birilium Blockchain Node Configuration v2.0
# Copy this file to .env and customize for your deployment

# ============================================
# SERVER CONFIGURATION
# ============================================
HTTP_PORT=3001
P2P_PORT=6001
NODE_ENV=development

# ============================================
# SECURITY
# ============================================
# API Key (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Leave empty to disable (NOT RECOMMENDED FOR PRODUCTION)
API_KEY=

# Admin credentials for dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB (analytics/explorer only - OPTIONAL)
# If MongoDB is not installed, the wallet will run in memory-only mode
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=birilium

# ============================================
# PAYPAL CONFIGURATION (for subscriptions)
# ============================================
# Get your credentials from: https://developer.paypal.com/dashboard/

# Mode: 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox

# LIVE Credentials (for production - KEEP THESE SECRET!)
PAYPAL_CLIENT_ID=your_live_client_id_here
PAYPAL_CLIENT_SECRET=your_live_client_secret_here
PAYPAL_PLAN_ID=your_live_plan_id_here

# SANDBOX Credentials (for testing - no real money)
PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_SANDBOX_PLAN_ID=your_sandbox_plan_id_here

# ============================================
# CONTACT FORM EMAIL CONFIGURATION
# ============================================
# Gmail account for contact form submissions
CONTACT_EMAIL=biriliumcoin@gmail.com
# App password for Gmail (NOT your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
CONTACT_EMAIL_PASSWORD=your_gmail_app_password_here
