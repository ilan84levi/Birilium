# Birilium Blockchain Node Configuration - EXAMPLE FILE
# Copy this file to .env and replace all placeholder values with your actual credentials

# ============================================
# SERVER CONFIGURATION
# ============================================
HTTP_PORT=3001
P2P_PORT=6001
NODE_ENV=production

# ============================================
# SECURITY - REPLACE WITH YOUR OWN VALUES!
# ============================================
# Generate a random API key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=REPLACE_WITH_YOUR_GENERATED_API_KEY

# Admin credentials for dashboard (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8_CHARS

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite database (embedded, no server needed)
SQLITE_DB_PATH=./data/birilium.db
LEVELDB_PATH=./data/chainstate

# ============================================
# BLOCKCHAIN PARAMETERS (v2.0)
# ============================================
MAX_MEMPOOL_SIZE=10000
TX_EXPIRATION_TIME=3600000
MAX_BLOCK_SIZE=1000
MAX_BLOCK_SIZE_BYTES=1048576
INITIAL_DIFFICULTY=4
TARGET_BLOCK_TIME=30000
DIFFICULTY_ADJUSTMENT_INTERVAL=10

# TESTNET FEATURE: LWMA + MTP (Phase 2.2)
ENABLE_LWMA=false
LWMA_ADJUST_WINDOW=60

# ============================================
# P2P NETWORK (Phase 2.3 - Enhanced Security)
# ============================================
PEERS=ws://159.65.96.82:6001
MAX_PEERS=32
P2P_RATE_LIMIT=100
P2P_BAN_SCORE=100

# ============================================
# NODE-TO-NODE SYNC (Multi-node setup)
# ============================================
# Your node's unique ID (auto-generated if not set)
NODE_ID=node1
# Your node's public URL (other nodes use this to sync with you)
NODE_URL=https://api.birilium.com
# Comma-separated list of peer node URLs to sync with
PEER_NODES=https://node2.birilium.com,https://node3.birilium.com

# P2P TLS/WSS Encryption
# NOTE: Set to true after generating certificates with generate-certs.js
ENABLE_P2P_TLS=false
TLS_CERT_PATH=./certs/node-cert.pem
TLS_KEY_PATH=./certs/node-key.pem
P2P_TLS_CA_CERT=./certs/ca-cert.pem
P2P_TLS_REQUIRE_CLIENT_CERT=false

# Node Identity (unique P2P identity)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_PRIVATE_KEY=REPLACE_WITH_GENERATED_PRIVATE_KEY

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/node.log

# ============================================
# RATE LIMITING (API)
# ============================================
RATE_LIMIT_MAX=100
MINING_RATE_LIMIT_MAX=10

# ============================================
# CORS
# ============================================
# Production domains configured for your domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:*

# ============================================
# MONITORING
# ============================================
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ============================================
# PAYPAL CONFIGURATION (for subscriptions)
# ============================================
# Get credentials from: https://developer.paypal.com/dashboard/
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
PAYPAL_PLAN_ID=YOUR_PAYPAL_SUBSCRIPTION_PLAN_ID_HERE

# ============================================
# CONTACT FORM EMAIL CONFIGURATION (OPTIONAL)
# ============================================
# Gmail setup instructions:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password (format: xxxx xxxx xxxx xxxx)
CONTACT_EMAIL=your-email@gmail.com
CONTACT_EMAIL_PASSWORD=your-gmail-app-password-here

# ============================================
# SECURITY NOTES
# ============================================
# - NEVER commit the .env file to version control
# - Keep your PayPal Client Secret secure (it can access funds)
# - Use strong passwords (minimum 12 characters recommended)
# - Rotate credentials regularly
# - Store backups securely and encrypted
