{
  "name": "birilium-wallet",
  "version": "1.5.3",
  "description": "Birilium Cryptocurrency Desktop Wallet",
  "homepage": "https://birilium.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64",
    "build:mac:universal": "electron-builder --mac --universal",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "keywords": [
    "cryptocurrency",
    "wallet",
    "birilium",
    "blockchain"
  ],
  "author": {
    "name": "Birilium Team",
    "email": "biriliumcoin@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "electron": "^39.8.4",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.birilium.wallet",
    "productName": "Birilium Wallet",
    "copyright": "Copyright © 2025 Birilium Team",
    "directories": {
      "output": "distribution",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-enhanced-crypto.js",
      "index.html",
      "styles.css",
      "renderer-wallet.js",
      "wallet-security.js",
      "ui-enhancements.js",
      "debug-terms.html",
      "icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "node-backend",
        "to": "app/node-backend",
        "filter": [
          "**/*",
          "!data/**",
          "!logs/**",
          "!**/*.log",
          "!.env",
          "!.env.*",
          "!*.env",
          "!certs/**",
          "!**/*.pem",
          "!**/*.key"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "Birilium Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Birilium Wallet",
      "deleteAppDataOnUninstall": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterSign": "scripts/notarize.js",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "build/icon.png",
      "maintainer": "Birilium Team <biriliumcoin@gmail.com>"
    },
    "publish": [{
      "provider": "github",
      "owner": "ilan84levi",
      "repo": "Birilium"
    }]
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "argon2": "^0.44.0",
    "bip32": "^5.0.0",
    "bip39": "^3.1.0",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "tiny-secp256k1": "^2.2.4"
  }
}
