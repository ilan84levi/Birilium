{
  "name": "birilium-wallet",
  "version": "1.2.0",
  "description": "Birilium Cryptocurrency Desktop Wallet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "keywords": [
    "cryptocurrency",
    "wallet",
    "birilium",
    "blockchain"
  ],
  "author": "Birilium Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.birilium.wallet",
    "productName": "Birilium Wallet",
    "copyright": "Copyright © 2025 Birilium Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-enhanced-crypto.js",
      "index.html",
      "styles.css",
      "renderer-wallet.js",
      "wallet-security.js",
      "ui-enhancements.js",
      "debug-terms.html",
      "icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "node-backend",
        "to": "app/node-backend",
        "filter": [
          "**/*",
          "!data/**",
          "!logs/**",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "Birilium Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Birilium Wallet",
      "deleteAppDataOnUninstall": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "argon2": "^0.44.0",
    "bip32": "^5.0.0",
    "bip39": "^3.1.0",
    "crypto-js": "^4.2.0",
    "@noble/secp256k1": "^3.0.0",
    "qrcode": "^1.5.4",
    "tiny-secp256k1": "^2.2.4"
  }
}
